<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GoPay Merchant API — Developer Console</title>
<style>
:root{--bg:#07090d;--panel:#0d1118;--panel2:#111720;--line:#202936;--text:#f4f7fb;--muted:#8c98a8;--green:#36e39a;--green2:#17b978;--blue:#78a9ff;--red:#ff6b7a;--shadow:0 24px 70px rgba(0,0,0,.35)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 15% -10%,rgba(54,227,154,.13),transparent 34%),radial-gradient(circle at 85% 5%,rgba(120,169,255,.10),transparent 30%),var(--bg);color:var(--text);font:14px Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,#000,transparent 75%)}
a{color:inherit}.shell{max-width:1180px;margin:auto;padding:0 22px}.nav{height:74px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20;background:rgba(7,9,13,.76);backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:12px;font-weight:800}.logo{width:40px;height:40px;border:1px solid rgba(54,227,154,.3);border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,#13261f,#0d1514);box-shadow:0 0 30px rgba(54,227,154,.12);color:var(--green);font-weight:900;font-size:18px}.brand small{display:block;color:var(--muted);font-size:10px;font-weight:600;margin-top:2px}.live{display:flex;align-items:center;gap:7px;border:1px solid rgba(54,227,154,.2);background:rgba(54,227,154,.06);padding:8px 12px;border-radius:999px;color:#a8f8d4;font-size:11px;font-weight:800}.dot{width:6px;height:6px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green);animation:pulse 2s infinite}@keyframes pulse{50%{opacity:.45;transform:scale(.75)}}
main{padding:60px 0 90px}.hero{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end;margin-bottom:42px}.eyebrow{color:var(--green);font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:900}.hero h1{font-size:clamp(38px,6vw,64px);letter-spacing:-.055em;line-height:.98;margin:12px 0 16px}.hero p{color:var(--muted);max-width:650px;font-size:15px;line-height:1.7;margin:0}.hero-stat{border:1px solid var(--line);background:rgba(13,17,24,.8);padding:18px 22px;border-radius:18px;min-width:170px;box-shadow:var(--shadow)}.hero-stat strong{display:block;font-size:27px}.hero-stat span{color:var(--muted);font-size:11px}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.section-head h2{font-size:16px;margin:0}.section-head span{font-size:11px;color:var(--muted)}
.grid{display:grid;gap:16px}.endpoint{border:1px solid var(--line);background:linear-gradient(145deg,rgba(17,23,32,.96),rgba(10,14,20,.96));border-radius:20px;overflow:hidden;box-shadow:0 10px 35px rgba(0,0,0,.16);transition:.28s ease}.endpoint:hover{border-color:#303b4b;transform:translateY(-2px);box-shadow:var(--shadow)}.top{padding:20px 20px 16px;display:flex;align-items:flex-start;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line)}.route{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.method{font:800 10px ui-monospace,monospace;color:#06140e;background:var(--green);padding:5px 7px;border-radius:6px}.path{font:700 14px ui-monospace,monospace}.desc{color:var(--muted);font-size:12px;margin-top:9px;line-height:1.55}.top-copy,.copy-response,.copy-status{border:1px solid #2a3441;background:#141b24;color:#dce4ed;border-radius:9px;padding:8px 10px;font-size:10px;font-weight:800;cursor:pointer;transition:.2s}.top-copy:hover,.copy-response:hover,.copy-status:hover{border-color:#3e4c5e;background:#1a232f}.body{padding:18px 20px}.params{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field{border:1px solid #252f3c;background:#0a0e14;border-radius:11px;transition:.2s}.field:focus-within{border-color:#356b57;box-shadow:0 0 0 3px rgba(54,227,154,.06)}.field label{display:block;color:#7f8b9b;text-transform:uppercase;font-size:9px;font-weight:900;letter-spacing:.1em;padding:10px 11px 0}.field input{width:100%;border:0;outline:0;background:transparent;color:#eef3f8;padding:7px 11px 11px;font:12px ui-monospace,monospace}.field input::placeholder{color:#485363}.actions{display:flex;gap:8px;margin-top:12px}.run{border:0;border-radius:10px;padding:10px 14px;background:linear-gradient(135deg,var(--green),#21c887);color:#03120c;font-weight:900;font-size:11px;cursor:pointer;box-shadow:0 7px 22px rgba(54,227,154,.12);transition:.22s}.run:hover{transform:translateY(-1px);box-shadow:0 10px 28px rgba(54,227,154,.2)}.run:active{transform:translateY(0)}.result{margin-top:15px;border:1px solid #202b38;border-radius:13px;overflow:hidden;background:#080b10}.result-head{min-height:38px;padding:0 11px 0 13px;display:flex;align-items:center;gap:10px;border-bottom:1px solid #1d2632;font-size:10px;font-weight:900;letter-spacing:.06em}.result-title{margin-right:auto;color:#8d99a9}.status{color:#aeb9c7;font-family:ui-monospace,monospace}.copy-status{padding:5px 9px;font-size:9px}.copy-response{padding:5px 9px;font-size:9px}.result pre{margin:0;padding:14px;color:#c9f7e1;font:11px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;min-height:70px;max-height:330px;overflow:auto;white-space:pre-wrap;word-break:break-word}.docs{margin-top:22px;border:1px solid var(--line);border-radius:20px;background:rgba(13,17,24,.75);padding:20px}.docs h2{margin:0 0 6px;font-size:15px}.docs p{margin:0 0 14px;color:var(--muted);font-size:12px}.docgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.doc{border:1px solid #232d39;background:#0a0e14;border-radius:10px;padding:10px;color:#9ba7b7;font:10px ui-monospace,monospace}.toast{position:fixed;right:20px;bottom:20px;z-index:50;background:#eafef5;color:#06150e;border-radius:12px;padding:11px 14px;font-size:11px;font-weight:900;box-shadow:0 18px 50px rgba(0,0,0,.35);opacity:0;transform:translateY(12px);transition:.25s}.toast.show{opacity:1;transform:none}
@media(max-width:800px){.hero{grid-template-columns:1fr}.hero-stat{display:none}.docgrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.shell{padding:0 14px}.nav{height:66px}.brand small{display:none}.hero{padding-top:20px;margin-bottom:30px}.top{flex-direction:column}.top-copy{align-self:flex-start}.params{grid-template-columns:1fr}.actions .run{width:100%}.docgrid{grid-template-columns:1fr}}
</style>
<style>
.field-help-example{margin-top:6px;font-size:12px;color:#7f8aa3}
.field-help-example strong{display:block;color:#cbd5e1;font-weight:600;margin-bottom:2px}
.example-stack{display:flex;flex-direction:column;gap:3px}
</style></head>
<body>
<header><div class="shell nav"><div class="brand"><div class="logo">G</div><div>GoPay Merchant<small>Developer Console</small></div></div><div class="live"><i class="dot"></i> LIVE API</div></div></header>
<main class="shell">
<section class="hero"><div><div class="eyebrow">API Explorer</div><h1>GoPay Merchant.</h1><p>Console modern untuk menguji endpoint GoPay Merchant. Isi parameter, jalankan request, lalu periksa response JSON secara real-time.</p></div><div class="hero-stat"><strong>5</strong><span>available endpoints</span></div></section>
<div class="section-head"><h2>Endpoints</h2><span>GET · REST API</span></div>
<section class="grid">

<div class="endpoint"><div class="top"><div><div class="route"><span class="method">GET</span><span class="path">/gopay/otp</span></div><div class="desc">Meminta OTP GoPay Merchant menggunakan email dan nomor telepon.</div></div><button class="top-copy" onclick="copyUrl('/gopay/otp',['email','phone'])">COPY URL</button></div><div class="body"><div class="params"><div class="field"><label>Email</label><input id="otp-email" type="email" placeholder="email@example.com"></div><div class="field"><label>Phone</label><input id="otp-phone" type="tel" placeholder="87890"></div></div><div class="actions"><button class="run" onclick="run('/gopay/otp',{email:v('otp-email'),phone:v('otp-phone')},'r-otp')">RUN REQUEST →</button></div><Result id="r-otp"></Result></div></div>

<div class="endpoint"><div class="top"><div><div class="route"><span class="method">GET</span><span class="path">/gopay/token</span></div><div class="desc">Memverifikasi OTP dan memperoleh access token.</div></div><button class="top-copy" onclick="copyUrl('/gopay/token',['otp','otp_token'])">COPY URL</button></div><div class="body"><div class="params"><div class="field"><label>OTP</label><input id="token-otp" inputmode="numeric" maxlength="6" placeholder="OTP"></div><div class="field"><label>OTP Token</label><input id="token-otp-token" placeholder="token dari /gopay/otp"></div></div><div class="actions"><button class="run" onclick="run('/gopay/token',{otp:v('token-otp'),otp_token:v('token-otp-token')},'r-token')">RUN REQUEST →</button></div><Result id="r-token"></Result></div></div>

<div class="endpoint"><div class="top"><div><div class="route"><span class="method">GET</span><span class="path">/gopay/qris/create</span></div><div class="desc">Membuat QRIS dinamis dari static QR dan nominal pembayaran.</div></div><button class="top-copy" onclick="copyUrl('/gopay/qris/create',['amount','static_qr'])">COPY URL</button></div><div class="body"><div class="params"><div class="field"><label>Amount</label><input id="qris-amount" type="number" min="1" placeholder="10000"></div><div class="field"><label>Static QR</label><input id="qris-static" placeholder="000201010212..."></div></div><div class="actions"><button class="run" onclick="run('/gopay/qris/create',{amount:v('qris-amount'),static_qr:v('qris-static')},'r-qris')">RUN REQUEST →</button></div><Result id="r-qris"></Result></div></div>

<div class="endpoint"><div class="top"><div><div class="route"><span class="method">GET</span><span class="path">/gopay/mutasi</span></div><div class="desc">Melihat riwayat transaksi QRIS GoPay. Start time bersifat opsional.</div></div><button class="top-copy" onclick="copyUrl('/gopay/mutasi',['token','start_time'])">COPY URL</button></div><div class="body"><div class="params"><div class="field"><label>Access Token</label><input id="mutasi-token" placeholder="access_token"></div><div class="field"><label>Start Time</label><input id="mutasi-start" type="datetime-local"></div></div><div class="actions"><button class="run" onclick="run('/gopay/mutasi',{token:v('mutasi-token'),start_time:v('mutasi-start')},'r-mutasi')">RUN REQUEST →</button></div><Result id="r-mutasi"></Result></div></div>

<div class="endpoint"><div class="top"><div><div class="route"><span class="method">GET</span><span class="path">/gopay/refresh</span></div><div class="desc">Memperbarui access token menggunakan refresh token.</div></div><button class="top-copy" onclick="copyUrl('/gopay/refresh',['refresh_token'])">COPY URL</button></div><div class="body"><div class="params"><div class="field"><label>Refresh Token</label><input id="refresh-token" placeholder="refresh_token"></div></div><div class="actions"><button class="run" onclick="run('/gopay/refresh',{refresh_token:v('refresh-token')},'r-refresh')">RUN REQUEST →</button></div><Result id="r-refresh"></Result></div></div>

</section>
<section class="docs"><h2>Quick Reference</h2><p>Semua endpoint menggunakan GET dengan query string. Response dikembalikan dalam JSON.</p><div class="docgrid"><div class="doc">GET /gopay/otp</div><div class="doc">GET /gopay/token</div><div class="doc">GET /gopay/qris/create</div><div class="doc">GET /gopay/mutasi</div><div class="doc">GET /gopay/refresh</div></div></section>
</main><div class="toast" id="toast"></div>
<script>
function v(id){return(document.getElementById(id)?.value||'').trim()}
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.classList.add('show');clearTimeout(window._toast);window._toast=setTimeout(()=>e.classList.remove('show'),1800)}
const map={email:'otp-email',phone:'otp-phone',otp:'token-otp',otp_token:'token-otp-token',amount:'qris-amount',static_qr:'qris-static',token:'mutasi-token',start_time:'mutasi-start',refresh_token:'refresh-token'};
function makeUrl(path,names){const u=new URL(path,location.origin);names.forEach(n=>{let x=v(map[n]);if(x){if(n==='start_time')x=new Date(x).toISOString();u.searchParams.set(n,x)}});return u.toString()}
async function copyText(t){try{await navigator.clipboard.writeText(t);toast('Copied to clipboard')}catch{toast('Gagal menyalin')}}
function copyUrl(path,names){copyText(makeUrl(path,names))}
function Result(){return null}
function render(el,status,data,loading=false){
 const ok=status>=200&&status<300;
 const result=document.createElement('div');result.className='result';
 const head=document.createElement('div');head.className='result-head';
 const title=document.createElement('span');title.className='result-title';title.textContent=loading?'REQUEST':'RESPONSE';
 const st=document.createElement('span');st.className='status';st.textContent=loading?'...':`HTTP ${status}`;
 head.append(title,st);
 if(!loading){const cs=document.createElement('button');cs.className='copy-status';cs.textContent='COPY';cs.onclick=()=>copyText(`HTTP ${status}`);head.append(cs);const cr=document.createElement('button');cr.className='copy-response';cr.textContent='COPY JSON';cr.onclick=()=>copyText(typeof data==='string'?data:JSON.stringify(data,null,2));head.append(cr)}
 const pre=document.createElement('pre');pre.textContent=loading?'Request sedang diproses...':(typeof data==='string'?data:JSON.stringify(data,null,2));result.append(head,pre);el.replaceChildren(result)
}
async function run(path,params,id){
 const el=document.getElementById(id);render(el,0,null,true);
 Object.keys(params).forEach(k=>{if(params[k]===''||params[k]==null)delete params[k]});
 if(path==='/gopay/token'&&params.otp&&!/^\d{4,6}$/.test(params.otp)){render(el,400,{success:false,error:'OTP harus 4-6 digit angka'});return}
 if(path==='/gopay/mutasi'&&params.start_time)params.start_time=new Date(params.start_time).toISOString();
 try{const u=new URL(path,location.origin);Object.entries(params).forEach(([k,val])=>u.searchParams.set(k,val));const r=await fetch(u);const text=await r.text();let data;try{data=JSON.parse(text)}catch{data={raw:text}}render(el,r.status,data)}catch(e){render(el,0,{success:false,error:e.message})}
}
</script>
</body></html>